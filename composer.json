{
    "name": "code-gopher/laravel-workerman",
    "description": "基于 Workerman 的 Laravel/Lumen 常驻内存 HTTP 服务适配器",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "lumen",
        "workerman",
        "performance",
        "acceleration"
    ],
    "require": {
        "php": "^7.2|^8.0",
        "ext-json": "*",
        "vlucas/phpdotenv": "^3.0|^4.0|^5.0",
        "workerman/workerman": "^4.0|^5.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6",
        "symfony/http-foundation": "^4.4 || ^5.0 || ^6.0 || ^7.0",
        "laravel/framework": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "laravel/lumen-framework": "如果使用 Lumen 框架，需要安装此依赖"
    },
    "autoload": {
        "psr-4": {
            "CodeGopher\\LaravelWorkerman\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeGopher\\LaravelWorkerman\\WorkermanServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}